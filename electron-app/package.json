{
  "name": "painel-pedidos",
  "version": "1.0.0",
  "description": "Painel de Pedidos — CRM Venda Mais",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "br.com.crm.painelpedidos",
    "productName": "Painel de Pedidos",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Painel de Pedidos"
    }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  }
}
